DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf,.xlsx,.docx,.txt,.csv
# Core tracking needs no AI. All AI choices are explicit server configuration.
AI_PROVIDER=disabled
AI_MODEL=
AI_BASE_URL=http://127.0.0.1:11434
AI_EXTERNAL_ENABLED=false
AI_API_KEY=
