# Replace this hostname with an internal DNS name resolved by company PCs/phones.
# Keep the upstream bound to loopback. Caddy is the only LAN-facing listener.
kelun-it.local {
    tls internal
    encode gzip
    reverse_proxy 127.0.0.1:8000 {
        flush_interval -1
    }
    header Strict-Transport-Security "max-age=31536000"
}
